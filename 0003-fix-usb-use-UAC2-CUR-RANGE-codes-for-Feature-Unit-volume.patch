         for (channel in intArrayOf(1, 2, 0)) {
-            volumeControlTransfer("PROBE_${phase}_GET_CUR_VOL_ch$channel", 0xA1, 0x81, volumeSelector or channel, index, ByteArray(2), 2)
+            volumeControlTransfer(
